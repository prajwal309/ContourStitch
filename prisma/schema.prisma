generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String               @id @default(cuid())
  name              String?
  email             String?              @unique
  emailVerified     DateTime?
  image             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  accounts          Account[]
  sessions          Session[]
  profiles          MeasurementProfile[]
  organizedGroups   FamilyGroup[]        @relation("GroupOrganizer")
  familyMemberships FamilyMembership[]
  redeemedInvites   FamilyInvitation[]
  outfitSelections  OutfitSelection[]
  receivedFitShares FamilyProfileShare[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@unique([userId, provider])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum MeasurementUnit {
  cm
  in
}

enum MeasurementKey {
  height
  shoulder
  chest
  waist
  hip
  sleeve
  inseam
  outseam
  arm
  neck
}

enum MeasurementConfidence {
  low
  medium
  high
}

model MeasurementProfile {
  id          String                @id @default(cuid())
  userId      String
  unit        MeasurementUnit
  estimates   Json
  corrections Json
  missing     Json
  fingerprint String
  version     Int                   @default(1)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  revisions   MeasurementRevision[]

  @@unique([userId, fingerprint])
  @@index([userId, updatedAt])
}

model MeasurementRevision {
  id           String               @id @default(cuid())
  profileId    String
  version      Int
  unit         MeasurementUnit
  estimates    Json
  corrections  Json
  missing      Json
  recordedAt   DateTime
  profile      MeasurementProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  selections   OutfitSelection[]
  familyShares FamilyProfileShare[]
  measurements MeasurementObservation[]

  @@unique([profileId, version])
}

model MeasurementObservation {
  id            String                 @id @default(cuid())
  revisionId    String
  key           MeasurementKey
  valueCm       Float
  unit          MeasurementUnit
  uncertaintyCm Float?
  confidence    MeasurementConfidence
  method        String
  recordedAt    DateTime
  revision      MeasurementRevision    @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, key])
  @@index([key, recordedAt])
}

model FamilyGroup {
  id            String             @id @default(cuid())
  name          String
  occasion      String?
  collectionKey String
  organizerId   String
  createdAt     DateTime           @default(now())
  organizer     User               @relation("GroupOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  members       FamilyMembership[]
  invitations   FamilyInvitation[]
  selections    OutfitSelection[]

  @@index([organizerId])
}

model FamilyMembership {
  groupId  String
  userId   String
  joinedAt DateTime            @default(now())
  group    FamilyGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  fitShare FamilyProfileShare?

  @@id([groupId, userId])
  @@index([userId, joinedAt])
}

model FamilyProfileShare {
  groupId     String
  memberId    String
  organizerId String
  revisionId  String
  membership  FamilyMembership    @relation(fields: [groupId, memberId], references: [groupId, userId], onDelete: Cascade)
  organizer   User                @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  revision    MeasurementRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@id([groupId, memberId])
  @@index([organizerId])
  @@index([revisionId])
}

model FamilyInvitation {
  id           String      @id @default(cuid())
  groupId      String
  tokenHash    String      @unique
  createdAt    DateTime    @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  redeemedAt   DateTime?
  redeemedById String?
  group        FamilyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  redeemedBy   User?       @relation(fields: [redeemedById], references: [id], onDelete: SetNull)

  @@index([groupId, createdAt])
  @@index([redeemedById])
}

model OutfitSelection {
  id            String               @id @default(cuid())
  userId        String
  groupId       String?
  scopeKey      String
  productKey    String
  variantKey    String
  fitRevisionId String?
  extraCm       Json
  preference    String
  fitComplete   Boolean
  usesProfile   Boolean
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  group         FamilyGroup?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fitRevision   MeasurementRevision? @relation(fields: [fitRevisionId], references: [id], onDelete: SetNull)

  @@unique([userId, scopeKey])
  @@index([userId, updatedAt])
  @@index([groupId])
  @@index([fitRevisionId])
}
