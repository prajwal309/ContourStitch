{
  "name": "contourstitch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --no-experimental-webstorage node_modules/vitest/vitest.mjs run",
    "benchmark:multiview": "CONTOURSTITCH_BENCHMARK=1 npm test -- --disableConsoleIntercept tests/multiview-benchmark.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "postinstall": "prisma generate && node scripts/prepare-onnx.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:verify": "prisma migrate status && prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@mediapipe/tasks-vision": "1.0.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "lucide-react": "1.47.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "onnxruntime-web": "1.30.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "29.1.1",
    "prettier": "3.9.8",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "type": "module",
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.5"
    },
    "source-map-js": "1.2.4"
  }
}
